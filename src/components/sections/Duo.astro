---
// 版块 7 · 双栏区：左晨报（最新一期前 N 条）+ 右官宣（最近 N 条）。数据：data/morning/*.json、data/announce.json
// 官宣：Discord 和 X 混排（新→旧），同一条两边都有时一行两个标签；标题用中文译文（translations.json），没译的先显示英文原句；悬停看英文原句
import MorningList from '../MorningList.astro';
import { morning, morningIssues, announcements, md, weekday, hm } from '../../data';
const { section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const M = section.morning, A = section.announce;
const latest = morning.latest ? morningIssues[morning.latest] : null;
const ann = announcements.items.slice(0, A.show || 5);
const chLabel = (s: any) => (s.type === 'x' ? s.account : s.channel);
const types = new Set(announcements.items.flatMap((a: any) => a.sources.map((s: any) => s.type)));
const foot = types.has('discord') && types.has('x') ? A.footBoth : types.has('discord') ? A.footDiscord : A.footXOnly;
---
<section class="sec sec-duo" data-section="duo">
  <div class="wrap">
    <div class="duo">
      <div class="panel" id="morning">
        <div class="p-hd">
          <h2>{M.title}</h2>
          {latest && <span class="date">{md(latest.date)} {weekday(latest.date)}</span>}
          {latest?.updated_at && <span class="live">{hm(latest.updated_at)} 更新</span>}
          <a class="more" href={`${base}morning/`}>{M.more}</a>
        </div>
        {latest ? <MorningList items={latest.items} limit={M.show || 3} maxSources={M.maxSources || 3} detailHref={`${base}morning/${latest.date}/`} compact /> : <p class="items-empty">还没有晨报。</p>}
        <div class="p-ft"><span>{M.foot}</span><a href={latest ? `${base}morning/${latest.date}/` : `${base}morning/`}>{M.full}</a></div>
      </div>
      <div class="panel" id="announce">
        <div class="p-hd">
          <h2>{A.title}</h2>
          {announcements.translations?.ok > 0 && <span class="p-note">{A.aiNote}</span>}
          <a class="more" href={`${base}announce/`}>{A.more}</a>
        </div>
        <ul class="ann">
          {ann.map((a: any) => (
            <li class="an">
              <div class="meta">
                {a.sources.map((s: any) => <span class:list={['an-ch', { x: s.type === 'x' }]}>{chLabel(s)}</span>)}<span>{md(a.date)}</span>
              </div>
              <a class:list={['t', { en: !a.title_zh }]} href={a.url} target="_blank" rel="noopener" title={a.title_en}>{a.title_zh || a.title_en}{(a.flags || []).map((f: string) => <span class="flag">{f}</span>)}</a>
            </li>
          ))}
        </ul>
        <div class="p-ft"><span>{foot}</span></div>
      </div>
    </div>
  </div>
</section>
