---
// 官宣列表页 /announce/：全部官宣、全文。新模块，先只在预览构建生成（正式构建 getStaticPaths 返回空）
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/sections/SiteNav.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import { announcements, navLinks, renderAnnounce, bjDateTime } from '../../data';
import site from '../../site.json';
export function getStaticPaths() {
  return __PREVIEW__ ? [{ params: { p: undefined } }] : [];
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const A = announcements;
const types = new Set(A.items.flatMap((a: any) => a.sources.map((s: any) => s.type)));
const srcLine = [types.has('discord') && `Hyperliquid Discord ${A.discord.keep_channels.join('、')}`, types.has('x') && `官方 X ${A.x.accounts.join('、')}`].filter(Boolean).join(' 与 ');
// 正文：原文照录。标题如果就是原文第一行（去掉 ** 后），正文从第二行起，免得重复；否则（标题是从长第一行截的第一句）正文显示全文
const bodyOf = (a: any) => {
  const lines = a.text.split('\n');
  const i = lines.findIndex((l: string) => l.trim());
  const first = i < 0 ? '' : lines[i].replace(/\*\*/g, '').trim().replace(/\s*[:：]$/, '');
  return !a.title_zh && first === a.title_en ? lines.slice(i + 1).join('\n').replace(/^\s*\n/, '') : a.text;  // 有中文标题时英文原文整段照录
};
---
<Base title={`官宣 · ${site.name}`}>
  <SiteNav links={navLinks(base)} active="announce" />
  <main class="wrap apage">
    <div class="art-hd">
      <div class="kick">官宣 · 共 {A.items.length} 条</div>
      <h1>Hyperliquid 官宣</h1>
      <div class="disc">
        <span>来源：{srcLine} · 时间为北京时间</span>
        <span><b>标题为 AI 翻译，以原文为准</b> · 下面是英文原文</span>
      </div>
    </div>
    <ul class="alist">
      {A.items.map((a: any) => (
        <li class="panel acard" id={a.id.replace(':', '-')}>
          <div class="meta">{a.sources.map((s: any) => <span class:list={['an-ch', { x: s.type === 'x' }]}>{s.type === 'x' ? s.account : s.channel}</span>)}<span>{bjDateTime(a.created_at)}</span></div>
          <h3 title={a.title_en}>{a.title_zh || a.title_en}</h3>
          <div class="abody" set:html={renderAnnounce(bodyOf(a))} />
          <div class="origs">
            <a class="orig" href={a.url} target="_blank" rel="noopener">{a.sources[0].type === 'x' ? '在 X 查看原帖 ↗' : '在 Discord 查看原文 ↗'}</a>
            {a.x_url && <a class="orig" href={a.x_url} target="_blank" rel="noopener">在 X 查看 ↗</a>}
          </div>
        </li>
      ))}
    </ul>
  </main>
  <SiteFooter />
</Base>
