---
// /dev/data/：数据自检页，只在预览构建生成（正式构建 getStaticPaths 返回空），始终 noindex
import Base from '../../layouts/Base.astro';
import { morning, morningIssues, announcements } from '../../data';
export function getStaticPaths() {
  return __PREVIEW__ ? [{ params: { page: 'data' } }] : [];
}
const parsedFiles = import.meta.glob('../../data/morning/parsed/*.json', { eager: true, import: 'default' });
const parsed: Record<string, any> = Object.fromEntries(Object.entries(parsedFiles).map(([k, v]) => [k.match(/(\d{4}-\d{2}-\d{2})\.json$/)![1], v]));
const tot = morning.items.reduce((a: any, x: any) => ({ items: a.items + x.items, skipped: a.skipped + x.skipped, long: a.long + x.long_titles }), { items: 0, skipped: 0, long: 0 });
---
<Base title="数据自检 · 预览" noindex>
  <main class="wrap devdata">
    <h1>数据自检</h1>
    <p class="muted">只在预览站。晨报生成于 {morning.generated_at}，官宣生成于 {announcements.generated_at}。</p>

    <h2>晨报 · {morning.items.length} 期（缺文件：{morning.missing.length ? morning.missing.join('、') : '无'}）</h2>
    <p class="muted">每期数据来源：用 site.json {morning.items.filter((x: any) => x.origin === 'site.json').length} 期，过渡数据 {morning.items.filter((x: any) => x.origin !== 'site.json').length} 期（其中 site.json 有误回退 {morning.items.filter((x: any) => x.origin.includes('有误')).length} 期）。网站条目共 {tot.items} 条；因不确定标记去掉 {tot.skipped} 条；标题超 28 字 {tot.long} 条（没截断）。</p>
    <table>
      <thead><tr><th>日期</th><th>期</th><th>来源</th><th>格式</th><th>今天怎么看</th><th>观点</th><th>带标记</th><th>上站</th><th>超 28 字</th><th>更新时间</th><th>警告</th></tr></thead>
      <tbody>
        {morning.items.map((x: any) => (
          <tr><td><a href={`#m-${x.date}`}>{x.date}</a></td><td>{x.issue_no}</td><td><span class:list={['org', { ok: x.origin === 'site.json', bad: x.origin.includes('有误') }]}>{x.origin}</span></td><td>{x.parsed?.format}</td><td>{x.parsed?.today_paragraphs} 段</td><td>{x.parsed?.views}</td><td>{x.parsed?.uncertain_views}</td><td>{x.items}</td><td>{x.long_titles}</td><td>{x.updated_at?.slice(5, 16).replace('T', ' ') || '—'}</td><td>{x.parsed?.warnings?.length ? x.parsed.warnings.join('；') : ''}</td></tr>
        ))}
      </tbody>
    </table>

    {morning.dates.map((d: string) => {
      const s = morningIssues[d], p = parsed[d], r = s._report || {};
      return (
        <section id={`m-${d}`} class="dd-issue">
          <h3>{d} · {p?.title} <span class:list={['org', { ok: morning.items.find((y: any) => y.date === d)?.origin === 'site.json', bad: morning.items.find((y: any) => y.date === d)?.origin.includes('有误') }]}>{morning.items.find((y: any) => y.date === d)?.origin}</span></h3>
          <p class="muted">窗口：{s.window ? `${s.window.start} → ${s.window.end}` : '—'}</p>
          {p && <details><summary>今天怎么看（{p.today.length} 段）</summary>{p.today.map((t: string) => <p>{t}</p>)}</details>}
          <ol>
            {s.items.map((it: any) => (
              <li>
                <b>{it.title}</b> <span class:list={['len', { bad: it.title.length > 28 }]}>{it.title.length} 字</span>
                {(it.flags || []).map((f: string) => <span class="flag">{f}</span>)}
                <div>{it.summary || <em class="bad">（没有说明）</em>}</div>
                <div class="muted">出处（{it.ref?.source_field}）：{it.sources.map((x: any) => <a href={x.url} target="_blank" rel="noopener">{x.name}</a>)}</div>
              </li>
            ))}
          </ol>
          {r.problems?.length > 0 && <ul class="problems">{r.problems.map((q: any) => <li>site.json 问题 [{q.level}{q.item ? ` 条目 ${q.item}` : ''}] {q.msg}</li>)}</ul>}
          {r.skipped?.length > 0 && <ul class="skipped">{r.skipped.map((x: any) => <li>没放：观点 {x.num}「{x.title}」—— {x.reason}</li>)}</ul>}
        </section>
      );
    })}

    <h2>官宣 · {announcements.items.length} 行 · Discord + X 混排</h2>
    <p class="muted">
      Discord：<span class:list={['org', { ok: announcements.discord_ok, bad: !announcements.discord_ok }]}>{announcements.discord_ok ? `正常（${announcements.discord.stats.kept} 条）` : `这次没有：${announcements.discord_problem}`}</span>
      · X：{announcements.x.stats.reduce((n: number, s: any) => n + (s.kept || 0), 0)} 条（{announcements.x.accounts.join('、')}，原创{announcements.x.keep.quoted ? '+引用' : ''}，不含回复和转推）
      · 合并成一行：{announcements.counts.merged} 对 · 只有 Discord {announcements.counts.discord_only} 行 · 只有 X {announcements.counts.x_only} 行
      · 中文标题：已译 {announcements.translations.ok}，待译 {announcements.translations.pending}
    </p>
    {announcements.translations.warnings?.length > 0 && <ul class="problems">{announcements.translations.warnings.map((w: string) => <li>{w}</li>)}</ul>}
    <p class="muted">合并的对：{announcements.merged_pairs.length ? announcements.merged_pairs.map((p: any) => `${p.d} ⇄ ${p.x}（相差 ${p.hours} 小时，Jaccard ${p.jaccard}，包含度 ${p.containment}）`).join('；') : '无'}。像但没合并的：{announcements.near_misses.length ? announcements.near_misses.map((p: any) => `${p.d} / ${p.x}（Jaccard ${p.jaccard}，包含度 ${p.containment}）`).join('；') : '无'}</p>
    {announcements.discord.stats?.fetched_at && (
      <table>
        <thead><tr><th>Discord 抓取时间</th><th>页数</th><th>消息</th><th>保留</th><th>按频道</th><th>去掉（按原因）</th></tr></thead>
        <tbody><tr>
          <td>{announcements.discord.stats.fetched_at}</td><td>{announcements.discord.stats.pages}</td><td>{announcements.discord.stats.messages}</td><td>{announcements.discord.stats.kept}</td>
          <td>{Object.entries(announcements.discord.stats.kept_by_channel).map(([k, v]) => <div>{k}：{v}</div>)}</td>
          <td>{Object.entries(announcements.discord.stats.dropped).map(([k, v]) => <div>{k}：{v}</div>)}</td>
        </tr></tbody>
      </table>
    )}
    {announcements.x.stats && (
      <table>
        <thead><tr><th>X 账号</th><th>抓到</th><th>保留</th><th>去掉（回复/转推）</th></tr></thead>
        <tbody>{announcements.x.stats.map((s: any) => <tr><td>{s.source}</td><td>{s.fetched ?? '—'}</td><td>{s.kept ?? 0}</td><td>{s.dropped ? `${s.dropped.reply} / ${s.dropped.retweet}${s.out_of_window ? `（另有 ${s.out_of_window} 条超出 ${announcements.window_days} 天）` : ''}` : s.status}</td></tr>)}</tbody>
      </table>
    )}
    <ol>
      {announcements.items.map((a: any) => (
        <li class="dd-ann">
          <div class="muted">{a.created_at.slice(0, 16).replace('T', ' ')} 北京时间 · {a.sources.map((s: any) => `${s.type} ${s.account || s.channel}`).join(' + ')} · {a.kind}{a.long ? ' · 长文' : ''} · <a href={a.url} target="_blank" rel="noopener">原文</a>{a.mirror_url && <a href={a.mirror_url} target="_blank" rel="noopener">Kyle 服务器里的转发</a>}</div>
          <b>{a.title_zh || '（待译）'}</b> <span class="muted">← {a.title_en}</span>{a.excerpt && <div class="muted">摘要：{a.excerpt.slice(0, 160)}{a.excerpt.length > 160 ? '…' : ''}</div>}
          <details><summary>完整原文</summary><pre>{a.text}</pre></details>
        </li>
      ))}
    </ol>
  </main>
</Base>
<style>
  .devdata { padding: 32px 24px 80px; font-size: 14px; line-height: 1.6; }
  .devdata h1 { font-size: 28px; font-weight: 800; }
  .devdata h2 { font-size: 20px; font-weight: 800; margin: 32px 0 8px; }
  .devdata h3 { font-size: 16px; font-weight: 700; margin: 24px 0 4px; }
  .devdata table { border-collapse: collapse; width: 100%; font-size: 12.5px; background: #fff; }
  .devdata th, .devdata td { border: 1px solid var(--c-divider); padding: 4px 6px; text-align: left; vertical-align: top; }
  .devdata td:nth-child(-n+4) { white-space: nowrap; }
  .devdata ol { padding-left: 22px; }
  .devdata li { margin: 8px 0; }
  .devdata .muted { color: var(--c-text-2); font-size: 12.5px; }
  .devdata .muted a { margin-right: 8px; }
  .devdata .len { font-size: 11px; color: var(--c-text-3); }
  .devdata .bad { color: #C2410C; }
  .devdata .skipped { color: var(--c-text-3); font-size: 12.5px; padding-left: 18px; }
  .devdata pre { white-space: pre-wrap; font: inherit; background: #fff; padding: 8px; border-radius: 8px; }
  .devdata .org { font-size: 11px; font-weight: 650; border-radius: 4px; padding: 1px 6px; background: #F0F0EE; color: #333; }
  .devdata .org.ok { background: #E8F7F3; color: #072722; }
  .devdata .org.bad { background: #FEE2E2; color: #991B1B; }
  .devdata .problems { color: #991B1B; font-size: 12.5px; padding-left: 18px; }
  .devdata .dd-issue { border-top: 1px solid var(--c-divider); margin-top: 16px; }
</style>
